# Copy to .env and change what you need:  cp .env.example .env
# Everything here is optional. The values shown are the defaults.

# Host ports (always bound to 127.0.0.1)
FRONTEND_PORT=8080
ORDER_PORT=8000
PAYMENT_PORT=8001
INVENTORY_PORT=8002

# Failure injection at startup (0 = never, 1 = always). Can also be changed live in the UI.
ORDER_ERROR_RATE=0.03
PAYMENT_DECLINE_RATE=0.10
PAYMENT_ERROR_RATE=0.05
PAYMENT_TIMEOUT_RATE=0.03
INVENTORY_ERROR_RATE=0.05
INVENTORY_SLOW_RATE=0.10

# Seconds the order-service waits for payment/inventory before returning 504
DOWNSTREAM_TIMEOUT_SECONDS=2

# Traffic generator (profile "loadgen")
LOADGEN_RATE=2
LOADGEN_WAVE=true
