# Shop demo: 3 FastAPI microservices + React frontend (+ optional traffic generator)
#
#   docker compose up -d --build                          # start the app
#   docker compose --profile loadgen up -d                # also start steady background traffic
#
# All published ports are bound to 127.0.0.1 (laptop only, never a public interface).

name: shop-demo

x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  frontend:
    build: ./app/frontend
    image: shop-demo/frontend:1.0.0
    container_name: shop-frontend
    restart: unless-stopped
    ports:
      - "127.0.0.1:${FRONTEND_PORT:-8080}:80"
    depends_on:
      order-service:
        condition: service_healthy
    networks: [shop-net]
    logging: *default-logging

  order-service:
    build: ./app/order-service
    image: shop-demo/order-service:1.0.0
    container_name: shop-order-service
    restart: unless-stopped
    environment:
      INVENTORY_URL: http://inventory-service:8002
      PAYMENT_URL: http://payment-service:8001
      DOWNSTREAM_TIMEOUT_SECONDS: ${DOWNSTREAM_TIMEOUT_SECONDS:-2}
      ORDER_ERROR_RATE: ${ORDER_ERROR_RATE:-0.03}
    ports:
      - "127.0.0.1:${ORDER_PORT:-8000}:8000"
    depends_on:
      inventory-service:
        condition: service_healthy
      payment-service:
        condition: service_healthy
    networks: [shop-net]
    logging: *default-logging

  payment-service:
    build: ./app/payment-service
    image: shop-demo/payment-service:1.0.0
    container_name: shop-payment-service
    restart: unless-stopped
    environment:
      PAYMENT_DECLINE_RATE: ${PAYMENT_DECLINE_RATE:-0.10}
      PAYMENT_ERROR_RATE: ${PAYMENT_ERROR_RATE:-0.05}
      PAYMENT_TIMEOUT_RATE: ${PAYMENT_TIMEOUT_RATE:-0.03}
    ports:
      - "127.0.0.1:${PAYMENT_PORT:-8001}:8001"
    networks: [shop-net]
    logging: *default-logging

  inventory-service:
    build: ./app/inventory-service
    image: shop-demo/inventory-service:1.0.0
    container_name: shop-inventory-service
    restart: unless-stopped
    environment:
      INVENTORY_ERROR_RATE: ${INVENTORY_ERROR_RATE:-0.05}
      INVENTORY_SLOW_RATE: ${INVENTORY_SLOW_RATE:-0.10}
    ports:
      - "127.0.0.1:${INVENTORY_PORT:-8002}:8002"
    networks: [shop-net]
    logging: *default-logging

  # Optional: keeps a steady stream of orders flowing so graphs and logs are never empty.
  traffic-generator:
    profiles: ["loadgen"]
    build: ./app/traffic-generator
    image: shop-demo/traffic-generator:1.0.0
    container_name: shop-traffic-generator
    restart: unless-stopped
    environment:
      TARGET_URL: http://order-service:8000
      RATE: ${LOADGEN_RATE:-2}
      WAVE: ${LOADGEN_WAVE:-true}
    depends_on:
      order-service:
        condition: service_healthy
    networks: [shop-net]
    logging: *default-logging

networks:
  shop-net:
    # Fixed name, so your own monitoring stack can join it:
    #   networks: { shop-net: { external: true } }
    name: shop-net
